rules_version = '2';
// Schicht & Urlaub – Sicherheitsregeln
// Nur für die Cloud-Sicherung (localMode: false): jeder Nutzer hat genau ein eigenes Dokument,
// nur er selbst darf es lesen und ändern. Alles andere ist gesperrt.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    match /nutzer/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['data','updated'])
        && request.resource.data.data is string && request.resource.data.data.size() < 900000;
    }
  }
}
