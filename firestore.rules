rules_version = '2';
// Schicht & Urlaub – Sicherheitsregeln
// • nutzer/{uid}: eigene Cloud-Sicherung (nur wenn localMode: false) – nur der Nutzer selbst
// • Passwörter: ausschließlich in Firebase Authentication (als Hash), nie in Firestore
// • teams/…: Team-Funktion. Private Daten liegen NICHT hier – nur Kopien, die der Nutzer
//   ausdrücklich für den Admin freigegeben hat. Andere Mitglieder können sie nicht lesen.
//   Nur Admins dürfen Mitglieder entfernen/sperren, Admins ernennen, Einladungslinks sperren
//   und Änderungsvorschläge erstellen. Nur der betroffene Nutzer darf einem Vorschlag zustimmen
//   oder ihn ablehnen – den Urlaub selbst ändert nur sein eigenes Gerät.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /nutzer/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['data','updated'])
        && request.resource.data.data is string && request.resource.data.data.size() < 900000;
    }

    match /teams/{t} {
      function teamPath() { return /databases/$(database)/documents/teams/$(t); }
      function teamDoc() { return get(teamPath()); }
      function meDoc() { return /databases/$(database)/documents/teams/$(t)/members/$(request.auth.uid); }
      // hat eine Mitgliedschaft (auch wartend)
      function hasMe() { return signedIn() && exists(meDoc()); }
      // bestätigtes Mitglied
      function isMem() { return hasMe() && get(meDoc()).data.get('status','active') == 'active'; }
      function isAdm() { return isMem() && get(meDoc()).data.role in ['admin','deputy']; }
      function banned() { return exists(/databases/$(database)/documents/teams/$(t)/bans/$(request.auth.uid)); }

      // Team-Dokument (enthält den Einladungscode): nur Mitglieder. Beitritt läuft über invites/{code}.
      allow get: if hasMe();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isAdm();

      // Einladungscode = Dokument-ID. Wer den Link hat, kann ihn prüfen. Sperren = Dokument löschen.
      match /invites/{code} {
        allow get: if signedIn();
        allow list: if false;
        allow create, update, delete: if isAdm();
      }

      // Gesperrte Personen: nur Admins
      match /bans/{u} {
        allow read, write: if isAdm();
      }

      // Mitglieds-Profile: lesen nur das Mitglied selbst und Admins.
      match /members/{m} {
        allow get: if signedIn() && (m == request.auth.uid || isAdm());
        allow list: if isAdm();
        allow create: if signedIn() && m == request.auth.uid && !banned() && (
          // Gründer legt sich als Admin an
          (teamDoc().data.createdBy == request.auth.uid && request.resource.data.role == 'admin' && request.resource.data.status == 'active')
          // Beitritt per gültigem Einladungscode als Mitglied; mit „Beitritt bestätigen“ zuerst wartend
          || (request.resource.data.role == 'member'
              && exists(/databases/$(database)/documents/teams/$(t)/invites/$(request.resource.data.invite))
              && request.resource.data.status in ['active','pending']
              && (teamDoc().data.get('requireApproval', false) == false || request.resource.data.status == 'pending')));
        // Admin: Rolle, Bestätigung usw.; Mitglied: nur Name/Kinder/Namensanzeige (nie Rolle oder Status)
        allow update: if isAdm() || (m == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','kids','showName']));
        // Entfernen: nur Admins – oder man verlässt das Team selbst
        allow delete: if isAdm() || m == request.auth.uid;
      }

      // Urlaubs-Kopien: nur wer selbst freigegeben hat, legt sie an. Lesen dürfen NUR Admins und der Eigentümer.
      match /entries/{e} {
        allow read: if isAdm() || (isMem() && resource.data.uid == request.auth.uid);
        allow create, update: if isMem() && request.resource.data.uid == request.auth.uid;
        allow delete: if isAdm() || (signedIn() && resource.data.uid == request.auth.uid);
      }

      // Änderungsvorschläge: Admin erstellt/zieht zurück, nur der Betroffene stimmt zu oder lehnt ab.
      match /proposals/{p} {
        allow read: if isAdm() || (signedIn() && resource.data.uid == request.auth.uid);
        allow create: if isAdm() && request.resource.data.status == 'open' && request.resource.data.by == request.auth.uid;
        allow update: if (isAdm() && resource.data.status == 'open' && request.resource.data.status == 'withdrawn'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updated']))
          || (isMem() && resource.data.uid == request.auth.uid && resource.data.status == 'open'
              && request.resource.data.status in ['accepted','declined']
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updated']));
        allow delete: if isAdm();
      }

      // ältere Bereiche (nicht mehr genutzt): nur Admins
      match /notes/{n} {
        allow read, create: if isMem();
        allow delete: if isAdm();
      }
      match /conflicts/{c} {
        allow read, write: if isAdm();
      }
    }
  }
}
