rules_version = '2';
// Schicht & Urlaub – Sicherheitsregeln
// • nutzer/{uid}: eigene Cloud-Sicherung (nur wenn localMode: false) – nur der Nutzer selbst
// • Passwörter: ausschließlich in Firebase Authentication (als Hash), nie in Firestore
// • teams/…: Team-Funktion. Private Daten liegen NICHT hier – nur Kopien, die der Nutzer
//   ausdrücklich für den Admin freigegeben hat. Andere Mitglieder können sie nicht lesen.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /nutzer/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['data','updated'])
        && request.resource.data.data is string && request.resource.data.data.size() < 900000;
    }

    match /teams/{t} {
      function teamDoc() { return get(/databases/$(database)/documents/teams/$(t)); }
      function meDoc() { return /databases/$(database)/documents/teams/$(t)/members/$(request.auth.uid); }
      function isMem() { return signedIn() && exists(meDoc()); }
      function isAdm() { return isMem() && get(meDoc()).data.role in ['admin','deputy']; }

      // Name + Einladungscode prüfen beim Beitritt (Team-ID ist zufällig)
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdm() || (isMem() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deputyHint']));
      allow delete: if isMem() && get(meDoc()).data.role == 'admin';

      // Mitglieds-Profile (Name, Farbe, Rolle, Kinder-Angabe): lesen nur das Mitglied selbst und Admins/Vertreter.
      // Passwörter oder Passwort-Hashes liegen NIE in Firestore – sie verwaltet ausschließlich Firebase Authentication.
      match /members/{m} {
        allow read: if signedIn() && (m == request.auth.uid || isAdm());
        allow create: if signedIn() && m == request.auth.uid && (
          (teamDoc().data.createdBy == request.auth.uid && request.resource.data.role == 'admin')
          || (request.resource.data.invite == teamDoc().data.invite && request.resource.data.role == 'member'));
        allow update: if isAdm() || (m == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','kids','showName']));
        allow delete: if isAdm() || m == request.auth.uid;
      }
      // Urlaubs-Kopien: nur wer selbst freigegeben hat, legt sie an. Lesen dürfen NUR Admins/Vertreter und der Eigentümer.
      match /entries/{e} {
        allow read: if isAdm() || (isMem() && resource.data.uid == request.auth.uid);
        allow create, update: if isMem() && request.resource.data.uid == request.auth.uid;
        allow delete: if isMem() && (resource.data.uid == request.auth.uid || isAdm());
      }
      match /notes/{n} {
        allow read, create: if isMem();
        allow delete: if isAdm();
      }
      match /conflicts/{c} {
        allow read, create, update: if isMem();
        allow delete: if isAdm();
      }
    }
  }
}
